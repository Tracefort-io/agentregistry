# Server Configuration
# The address and port the server will listen on
AGENT_REGISTRY_SERVER_ADDRESS=:8080

# HTTP hardening
# Browser origins allowed to call the API from another site (comma-separated
# scheme://host[:port], or *). Empty: any origin with auth disabled,
# same-origin only with auth required.
AGENT_REGISTRY_CORS_ALLOWED_ORIGINS=
# Server timeouts (the MCP server applies read and idle, not write).
AGENT_REGISTRY_HTTP_READ_TIMEOUT=30s
AGENT_REGISTRY_HTTP_WRITE_TIMEOUT=2m
AGENT_REGISTRY_HTTP_IDLE_TIMEOUT=2m
# Largest request body in bytes; 0 for no limit.
AGENT_REGISTRY_HTTP_MAX_BODY_BYTES=1048576
# Strict-Transport-Security max-age when served over HTTPS; 0s sends none.
AGENT_REGISTRY_HTTP_HSTS_MAX_AGE=0s
# Replaces the web UI's Content-Security-Policy (default: own origin plus the
# sign-in service's).
AGENT_REGISTRY_HTTP_CSP=

# Database Configuration
# PostgreSQL connection string
AGENT_REGISTRY_DATABASE_URL=postgres://localhost:5432/agentregistry?sslmode=disable

# Secret payload storage (Database or Kubernetes). Empty disables Secret writes.
AGENT_REGISTRY_SECRET_STORE=
# Required for Database: a 64-character hex-encoded AES-256 key.
AGENT_REGISTRY_SECRET_STORE_ENCRYPTION_KEY=
# Namespace containing payload objects when using Kubernetes.
AGENT_REGISTRY_SECRET_STORE_KUBERNETES_NAMESPACE=agentregistry-system

# Leader election: which replica runs the background controllers.
# postgres (an advisory lock, default), kubernetes (a Lease), or none (one
# replica only). See docs/high-availability.md.
AGENT_REGISTRY_LEADER_ELECTION=postgres
AGENT_REGISTRY_LEADER_ELECTION_NAME=agentregistry-controllers
AGENT_REGISTRY_LEADER_ELECTION_LEASE_DURATION=15s
AGENT_REGISTRY_LEADER_ELECTION_RENEW_DEADLINE=10s
AGENT_REGISTRY_LEADER_ELECTION_RETRY_PERIOD=2s

# Audit log: every apply and delete, and every refused read, stored in
# Postgres and served to registry admins at GET /v0/audit.
AGENT_REGISTRY_AUDIT_ENABLED=true
# How long events are kept; 0 keeps them forever.
AGENT_REGISTRY_AUDIT_RETENTION=2160h
# Also export events as OpenTelemetry log records over OTLP/HTTP, configured by
# the standard variables, e.g. OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
AGENT_REGISTRY_AUDIT_OTLP=false

# Authentication and authorization
# "disabled" (default) or "required". With "required" the server refuses to
# start unless issuers and an AuthZEN PDP are configured. See
# docs/auth/authzen-contract.md.
AGENT_REGISTRY_AUTH_MODE=disabled
# JSON array of trusted token issuers, inline or from a file (the file wins), e.g.
# [{"issuer":"https://idp.example.com/realms/tracefort","audiences":["agentregistry"]}]
AGENT_REGISTRY_AUTH_ISSUERS=
AGENT_REGISTRY_AUTH_ISSUERS_FILE=
# Leeway for exp, nbf and iat.
AGENT_REGISTRY_AUTH_CLOCK_SKEW=30s
# How often the issuers' signing keys are fetched again: how long a key removed
# from the IdP is still trusted (new keys are picked up at once).
AGENT_REGISTRY_AUTH_JWKS_REFRESH=5m
# Exact paths served without a token.
AGENT_REGISTRY_AUTH_OPEN_PATHS=/health,/ping,/version
# Web UI sign-in (authorization code + PKCE): the issuer and the public client
# the browser signs in with. Set both, or neither. The UI reads them from
# /auth-config.json.
AGENT_REGISTRY_AUTH_UI_ISSUER=
AGENT_REGISTRY_AUTH_UI_CLIENT_ID=
AGENT_REGISTRY_AUTH_UI_SCOPES=openid profile email
# Public URL of the MCP endpoint. When set, the MCP server publishes RFC 9728
# protected-resource metadata naming the issuers above, so MCP clients can
# discover where to get a token.
AGENT_REGISTRY_AUTH_MCP_RESOURCE=
AGENT_REGISTRY_AUTH_MCP_SCOPES=
# OpenID AuthZEN 1.0 PDP base URL; endpoints are discovered from
# <url>/.well-known/authzen-configuration.
AGENT_REGISTRY_AUTHZEN_URL=
# Every PDP call is bounded by this; a timeout is a denial.
AGENT_REGISTRY_AUTHZEN_TIMEOUT=1500ms
# Permit decisions are cached this long; denials never are. 0 disables caching.
AGENT_REGISTRY_AUTHZEN_CACHE_TTL=5s
# How the registry authenticates to the PDP: OAuth 2.0 client credentials...
AGENT_REGISTRY_AUTHZEN_TOKEN_URL=
AGENT_REGISTRY_AUTHZEN_CLIENT_ID=
AGENT_REGISTRY_AUTHZEN_CLIENT_SECRET=
AGENT_REGISTRY_AUTHZEN_CLIENT_SECRET_FILE=
AGENT_REGISTRY_AUTHZEN_SCOPES=
# ...or a static bearer token, for PDPs without OAuth.
AGENT_REGISTRY_AUTHZEN_STATIC_TOKEN=
AGENT_REGISTRY_AUTHZEN_STATIC_TOKEN_FILE=
# Maximum rows a list request authorizes when the PDP has no Resource Search.
AGENT_REGISTRY_AUTHZEN_LIST_MAX=1000

# Application Version
# Set automatically during build, can be overridden for development
AGENT_REGISTRY_VERSION=dev

# Registry Validation
# Enable validation of registry package references
AGENT_REGISTRY_ENABLE_REGISTRY_VALIDATION=false

# MCP Registry v0.1 Compatibility (read-only)
# Re-exposes MCPServer resources in the official server.json shape at
# /v0.1/servers so registry-aware clients (e.g. VS Code's MCP gallery) can
# discover them. Anonymous and flattens all namespaces into one catalogue;
# bypasses per-kind RBAC list filters. OFF by default; enable only where an
# unauthenticated, cross-namespace MCP catalogue is acceptable.
# See docs/mcp-registry-compatibility.md.
AGENT_REGISTRY_MCP_REGISTRY_COMPAT_ENABLED=false
# Optional base prefix to mount the compatibility API under (e.g. /mcp-registry).
# Empty serves the spec's standard paths at the root.
AGENT_REGISTRY_MCP_REGISTRY_COMPAT_PATH_PREFIX=

# Claude Code Plugin Marketplace Compatibility (read-only)
# Re-exposes resolved Plugin resources as a Claude Code marketplace.json at
# /plugin-marketplace/marketplace.json so the URL can be registered directly
# with `claude plugin marketplace add`. Uses configured authentication and
# flattens all namespaces into one catalogue. OFF by default; enable only where
# a Plugin catalogue at this scope is acceptable.
# See docs/plugin-marketplace-compatibility.md.
AGENT_REGISTRY_PLUGIN_MARKETPLACE_COMPAT_ENABLED=false
# Optional base prefix to mount the compatibility API under (e.g. /plugins).
# Empty serves the standard path at the root.
AGENT_REGISTRY_PLUGIN_MARKETPLACE_COMPAT_PATH_PREFIX=
